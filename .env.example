# Copy to .env.local (git-ignored) and fill in. In Vercel, set these per environment and mark secrets "Sensitive".

# Public (shipped to the browser)
NEXT_PUBLIC_SITE_URL=https://islandsva.com
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Supabase — server only. Use a secret key (sb_secret_…), never the publishable key, never NEXT_PUBLIC_.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=

# Cloudflare Turnstile — required in production (contact form spam protection).
# Local testing: Cloudflare's public test keys 1x00000000000000000000AA / 1x0000000000000000000000000000000AA
# (rejected on the live deployment).
TURNSTILE_SECRET_KEY=

# Resend — lead notification email (sending domain must be verified)
RESEND_API_KEY=
LEADS_NOTIFY_EMAIL=
EMAIL_FROM="Islands VA <noreply@islandsva.com>"

# Random 32+ character string; hashes visitor IPs so raw IPs are never stored
IP_HASH_SECRET=
