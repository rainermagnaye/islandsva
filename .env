# Shared, NON-SECRET defaults — committed to git for the whole team.
# Your own values and every secret go in .env.local (git-ignored); it overrides anything set here.
# Never put a key, token or password in this file: `npm test` fails if a secret variable is set here.

# Public site
NEXT_PUBLIC_SITE_URL=https://islandsva.com

# Lead notification sender (domain must be verified in Resend)
EMAIL_FROM="Islands VA <noreply@islandsva.com>"

# ---------------------------------------------------------------------------------------------------------
# Set these in .env.local (copy the lines and fill them in). In Vercel, set them per environment and mark
# the secrets "Sensitive".
#
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=        public Turnstile site key (local testing: 1x00000000000000000000AA)
# SUPABASE_URL=                          https://<project-ref>.supabase.co (one project for now; a staging project is planned)
# SUPABASE_PUBLISHABLE_KEY=              sb_publishable_… — Dashboard → Project Settings → API Keys
# SUPABASE_SECRET_KEY=                   SECRET  sb_secret_… — bypasses RLS; lib/supabase/admin.ts only
# TURNSTILE_SECRET_KEY=                  SECRET  (local testing: 1x0000000000000000000000000000000AA)
# RESEND_API_KEY=                        SECRET
# LEADS_NOTIFY_EMAIL=                    inbox that receives new-lead emails
# IP_HASH_SECRET=                        SECRET  random 32+ characters; hashes visitor IPs
